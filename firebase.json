{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/karaoke",
        "destination": "/index.html"
      },
      {
        "source": "/karaoke/",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "regex": "^/(index\\.html|karaoke/?)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
